---
import BaseLayout from '../layouts/BaseLayout.astro';
import DryerInstallationIsland from '../components/islands/DryerInstallationIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Dryer Installation",
  "description": "Free professional dryer installation in Ocean Springs, MS included with every Sudsy Co. rental. Gas or electric connections available.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/dryer-installation/",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "0",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Dryer Installation" }
  ]
};
---

<BaseLayout
  title="Dryer Installation Ocean Springs MS | Free Setup | Sudsy Co."
  description="Free dryer installation in Ocean Springs, MS with every Sudsy Co. rental. We connect gas or electric dryers and haul away your old unit. Call (228) 338-3455."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Dryer Installation in Ocean Springs, MS</h1>
  <DryerInstallationIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What Dryer Installation Includes</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Every Sudsy Co. dryer installation covers:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li><strong>Delivery inside your home</strong> — no curbside drops, no "you figure out the stairs"</li>
  <li><strong>Electrical connection</strong> — standard 120V or 240V connection depending on your unit and hookup</li>
  <li><strong>Vent connection</strong> — we connect the dryer exhaust vent to your existing ductwork or vent port</li>
  <li><strong>Leveling</strong> — properly leveled to reduce vibration and wear</li>
  <li><strong>Test run</strong> — we run it before we leave to confirm everything works</li>
  <li><strong>Old dryer removal</strong> — if you have an old dryer taking up space, ask about <a href="/old-dryer-pickup" class="text-primary hover:underline">old dryer pickup</a></li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Electric Dryers on the Gulf Coast</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Most Gulf Coast homes and apartments are set up for electric dryers — a 240V outlet in the laundry area. That's what Sudsy Co. rentals use. If you're not sure what you have, check for a large four-prong or three-prong outlet near your laundry hookups. If it's there, you're ready to go.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What You Need Before We Arrive</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Standard dryer installation requires:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>A 240V electrical outlet (dryers draw too much power for a standard 120V outlet)</li>
  <li>An exterior vent port or dryer vent ductwork already in place</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">If your space doesn't have an existing vent, that's a construction issue we'd need to flag before installation. Most laundry areas on the Gulf Coast are already set up — but if you're renting in an older building or a converted space, it's worth confirming before we come out.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Dryer Installation Included With Rental — $59.99/mo</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Professional dryer installation is included in your $59.99/mo rental — no separate setup fee. If anything goes wrong with the dryer after installation, call us. We handle all maintenance and repairs as part of your rental.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">Month-to-month billing, no credit check, no long-term contract.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Service Area</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We install dryers across Jackson County and Harrison County:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Ocean Springs</li>
  <li>Biloxi</li>
  <li>Gulfport</li>
  <li>D'Iberville</li>
  <li>Pascagoula</li>
  <li>Gautier</li>
  <li>Long Beach</li>
  <li>Pass Christian</li>
  <li>Moss Point</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Schedule Dryer Installation</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> or <a href="#" class="text-primary hover:underline">get started online</a>. Next-day delivery and installation available across most of the Gulf Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Sudsy Co. Washer and Dryer Rentals</strong> Locally owned. Ocean Springs, MS. Serving the Mississippi Gulf Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
