---
import BaseLayout from '../layouts/BaseLayout.astro';
import DryerInstallationIsland from '../components/islands/DryerInstallationIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Dryer Installation",
  "description": "Free professional dryer installation in Ocean Springs, MS included with every Sudsy Co. rental. Gas or electric connections available.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/dryer-installation/",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "0",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Dryer Installation" }
  ]
};
---

<BaseLayout
  title="Dryer Installation Ocean Springs MS | Free Setup | Sudsy Co."
  description="Free dryer installation in Ocean Springs, MS with every Sudsy Co. rental. We connect gas or electric dryers and haul away your old unit. Call (228) 338-3455."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Dryer Installation in Ocean Springs, MS</h1>
  <DryerInstallationIsland client:only="react" />
</BaseLayout>
