---
import BaseLayout from '../layouts/BaseLayout.astro';
import OldDryerPickupIsland from '../components/islands/OldDryerPickupIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Old Dryer Pickup",
  "description": "Free old dryer removal in Ocean Springs, MS when you start a Sudsy Co. rental. We haul away your old machine at no extra charge.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/old-dryer-pickup/",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "0",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Old Dryer Pickup" }
  ]
};
---

<BaseLayout
  title="Old Dryer Pickup Ocean Springs MS | Free Removal | Sudsy Co."
  description="Free old dryer pickup in Ocean Springs, MS when you rent from Sudsy Co. We haul away your old machine at no extra charge. Call (228) 338-3455."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Old Dryer Pickup in Ocean Springs, MS</h1>
  <OldDryerPickupIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: How Old Dryer Pickup Works</h3>
<ol class="list-decimal list-inside space-y-2 text-muted-foreground mb-4">
  <li><strong>Book your rental</strong> — call (228) 338-3455 or start online</li>
  <li><strong>Mention the old dryer</strong> — let us know when you schedule so we come prepared</li>
  <li><strong>We deliver your rental and remove the old dryer</strong> — one trip handles it all</li>
  <li><strong>You're done</strong> — new machine installed, old one gone</li>
</ol>
<p class="text-muted-foreground mb-4 leading-relaxed">Need both an old washer and dryer removed? We'll take both. See <a href="/old-washer-pickup" class="text-primary hover:underline">old washer pickup</a>.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What Happens to Your Old Dryer</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">If your old dryer has usable life left, it may be refurbished and added to our rental or <a href="/used-washer-dryer-sales" class="text-primary hover:underline">used appliance sales</a> inventory. If it's truly finished, we dispose of it properly. Dryers contain components that require responsible disposal — we handle that so you don't have to navigate municipal waste rules on the Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Old Dryer Pickup Without a New Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Just need an old dryer removed without starting a rental? Contact us at (228) 338-3455 — depending on the machine's condition and our schedule, we may be able to help.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: The Real Cost of Leaving a Dead Dryer in Place</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Junk removal services on the Gulf Coast typically charge $75–$150 to haul away a single appliance. Municipal bulk pickup schedules aren't always convenient. And a dead dryer sitting in your laundry space takes up room you could actually use.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">When you start a Sudsy Co. rental, old dryer pickup is part of the deal — no separate fee, no second appointment.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Service Area</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Old dryer pickup available across Jackson County and Harrison County:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Ocean Springs</li>
  <li>Biloxi</li>
  <li>Gulfport</li>
  <li>D'Iberville</li>
  <li>Pascagoula</li>
  <li>Gautier</li>
  <li>Long Beach</li>
  <li>Pass Christian</li>
  <li>Moss Point</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Get Your Old Dryer Removed</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> or <a href="#" class="text-primary hover:underline">start your rental online</a>. Just mention the old dryer when you book.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Sudsy Co. Washer and Dryer Rentals</strong> Locally owned. Ocean Springs, MS. Serving the Mississippi Gulf Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
