---
import BaseLayout from '../layouts/BaseLayout.astro';
import MonthlyApplianceRentalIsland from '../components/islands/MonthlyApplianceRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Monthly Appliance Rental",
  "description": "Month-to-month washer and dryer rental in Ocean Springs with free delivery, free installation, and no long-term contract.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/monthly-appliance-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Monthly Appliance Rental" }
  ]
};
---

<BaseLayout
  title="Monthly Appliance Rental Ocean Springs MS | Sudsy Co."
  description="Monthly appliance rental in Ocean Springs, MS. Rent a washer and dryer month-to-month starting at $59.99/mo. Free delivery. No credit check. Cancel anytime."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Monthly Appliance Rental in Ocean Springs, MS</h1>
  <MonthlyApplianceRentalIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What Monthly Appliance Rental Includes</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Every Sudsy Co. monthly rental comes with:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li><strong>Free next-day delivery</strong> to your door anywhere on the Mississippi Gulf Coast</li>
  <li><strong>Free installation</strong> — we hook up your machine, you don't lift a finger</li>
  <li><strong>Month-to-month billing</strong> — no 12-month contracts, no cancellation fees</li>
  <li><strong>No credit check</strong> — we don't pull your credit, ever</li>
  <li><strong>Maintenance coverage</strong> — if something goes wrong with the machine, that's on us, not you</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Monthly Rental Pricing</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">| Plan | Price | What You Get | |------|-------|-------------| | Basic | $59.99/mo | Standard-capacity washer & dryer set |
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">Both plans include free delivery and free installation. No hidden fees.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Month-to-Month Means Real Flexibility</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">A lot of appliance rental companies lock you into annual contracts. We don't. Sudsy Co. rents month-to-month because we know that Gulf Coast life doesn't always follow a plan.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">If you get PCS orders, you can cancel without penalty. If you buy a house and invest in your own machines, just give us a call. If your landlord installs in-unit laundry, we'll come get our machine out of your way. No hassle, no fees.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Who Uses Monthly Appliance Rental on the Gulf Coast</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Monthly appliance rental works especially well for:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li><strong>Military families at Keesler AFB</strong> — short-duty assignments where buying doesn't make financial sense</li>
  <li><strong>Apartment renters</strong> who want the convenience of in-unit laundry without purchasing equipment</li>
  <li><strong>Homeowners between appliances</strong> — your washer broke and you need something while you figure out what to buy</li>
  <li><strong>Seasonal and snowbird residents</strong> who spend part of the year on the Mississippi Gulf Coast</li>
  <li><strong>Property managers and landlords</strong> who want to offer laundry to tenants without the capital expense</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Delivery Across the Mississippi Gulf Coast</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We deliver monthly appliance rentals to all of Jackson County and Harrison County:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Ocean Springs</li>
  <li>Biloxi</li>
  <li>Gulfport</li>
  <li>D'Iberville</li>
  <li>Pascagoula</li>
  <li>Gautier</li>
  <li>Long Beach</li>
  <li>Pass Christian</li>
  <li>Moss Point</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">Next-day delivery is available across most of our service area.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Get Started with Monthly Appliance Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> or <a href="#" class="text-primary hover:underline">start your rental online</a>. We'll have your appliance delivered and installed as soon as tomorrow.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Sudsy Co. Washer and Dryer Rentals</strong> Locally owned in Ocean Springs, MS. Serving the Mississippi Gulf Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
