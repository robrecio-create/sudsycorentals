---
import BaseLayout from '../layouts/BaseLayout.astro';
import VacationFurnitureRentalIsland from '../components/islands/VacationFurnitureRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Vacation Furniture Rental",
  "description": "Appliance and furniture rental for vacation homes and short-term rentals on the Mississippi Gulf Coast. Free delivery and flexible monthly terms.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/vacation-furniture-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Vacation Furniture Rental" }
  ]
};
---

<BaseLayout
  title="Vacation Furniture Rental Mississippi Gulf Coast | Sudsy Co."
  description="Vacation furniture rental on the Mississippi Gulf Coast. Washer, dryer, and appliance rentals for vacation homes and short-term rentals in Biloxi, Gulfport & Ocean Springs."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Vacation Furniture Rental on the Mississippi Gulf Coast</h1>
  <VacationFurnitureRentalIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Built for Short-Term and Seasonal Needs</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Vacation furniture rental works well for:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Vacation properties that need a quick furniture setup</li>
  <li>Seasonal stays on the Coast</li>
  <li>Short-term furnished rentals</li>
  <li>Owners refreshing a property without committing to full furniture purchases</li>
  <li>Temporary housing for guests, workers, or family</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Why It Makes Sense for Gulf Coast Properties</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Vacation and seasonal housing on the Mississippi Gulf Coast needs flexibility. Buying furniture for every temporary use case can get expensive fast. Renting lets you furnish the property you need today while keeping your costs and commitments lower.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Faster Than Piecing Everything Together Yourself</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Trying to source furniture piece by piece from big-box stores, Facebook Marketplace, or local pickups takes time and energy. Vacation furniture rental gives you a faster path to a furnished, usable space.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Local Coverage Across the Coast</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Sudsy Co. serves Ocean Springs, Biloxi, Gulfport, D'Iberville, Pascagoula, Gautier, Long Beach, Pass Christian, and Moss Point.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">That makes us a practical local option for Gulf Coast owners and residents who need furniture support without making this a full project.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Ask About Vacation Furniture Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> to ask about current availability and what type of setup you need.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
