---
import BaseLayout from '../layouts/BaseLayout.astro';
import VacationFurnitureRentalIsland from '../components/islands/VacationFurnitureRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Vacation Furniture Rental",
  "description": "Appliance and furniture rental for vacation homes and short-term rentals on the Mississippi Gulf Coast. Free delivery and flexible monthly terms.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/vacation-furniture-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Vacation Furniture Rental" }
  ]
};
---

<BaseLayout
  title="Vacation Furniture Rental Mississippi Gulf Coast | Sudsy Co."
  description="Vacation furniture rental on the Mississippi Gulf Coast. Washer, dryer, and appliance rentals for vacation homes and short-term rentals in Biloxi, Gulfport & Ocean Springs."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Vacation Furniture Rental on the Mississippi Gulf Coast</h1>
  <VacationFurnitureRentalIsland client:only="react" />
</BaseLayout>
