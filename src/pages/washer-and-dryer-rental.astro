---
import BaseLayout from '../layouts/BaseLayout.astro';
import WasherDryerRentalIsland from '../components/islands/WasherDryerRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Washer and Dryer Rental",
  "description": "Rent a washer and dryer in Ocean Springs starting at $59.99/mo with free next-day delivery, free installation, and no credit check.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/washer-and-dryer-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Washer and Dryer Rental" }
  ]
};
---

<BaseLayout
  title="Washer and Dryer Rental Ocean Springs MS | Sudsy Co."
  description="Rent a washer and dryer in Ocean Springs, MS for $59.99/mo. Free delivery, free installation, no credit check. Serving the Mississippi Gulf Coast. Call (228) 338-3455."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Washer and Dryer Rental in Ocean Springs, MS</h1>
  <WasherDryerRentalIsland client:only="react" />
</BaseLayout>
