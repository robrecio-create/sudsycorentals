---
import BaseLayout from '../layouts/BaseLayout.astro';
import UsedApplianceRentalIsland from '../components/islands/UsedApplianceRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Used Appliance Rental",
  "description": "Used washer and dryer rental in Ocean Springs with free delivery and installation. All appliances cleaned and serviced.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/used-appliance-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Used Appliance Rental" }
  ]
};
---

<BaseLayout
  title="Used Appliance Rental Ocean Springs MS | Sudsy Co."
  description="Used appliance rental in Ocean Springs, MS. Rent a washer and dryer starting at $59.99/mo. Free delivery and installation. No credit check. Serving the Mississippi Gulf Coast."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Used Appliance Rental in Ocean Springs, MS</h1>
  <UsedApplianceRentalIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What "Used" Means at Sudsy Co.</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Our rental inventory is professionally inspected, cleaned, and serviced before every placement. These aren't machines we pulled off a curb — they're appliances we maintain, repair, and stand behind. If something stops working while it's in your home, we handle it at no cost to you.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">Rental appliances are purpose-built for this kind of use. They get checked between every rental, which means you're often getting a better-maintained machine than something you'd pick up off Facebook Marketplace or Craigslist.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Pricing for Used Appliance Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">| Plan | Monthly Rate | Includes | |------|-------------|----------| | Basic | $59.99/mo | Standard-capacity washer & dryer set |
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">Free delivery. Free installation. Month-to-month. No hidden fees.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Used Appliance Rental vs. Buying Used</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Buying a used washer or dryer off a private seller on the Gulf Coast typically runs $200–$500 per machine — and that's before you figure out delivery, installation, and what happens when it breaks six months later. You're also on your own for repairs.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">With Sudsy Co., you pay $59.99/mo and we cover maintenance. No delivery costs, no installation fees, no repair bills. For most households, that's a better deal than rolling the dice on a used private sale — especially on the Coast where getting a repair tech out can take time.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: We Also Sell Used Washers and Dryers</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">If you'd rather own than rent, ask us about our used washer and dryer inventory. We periodically offer <a href="/used-washer-dryer-sales" class="text-primary hover:underline">used washer and dryer sales</a> for households that want a permanent solution at a reasonable price.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Service Area</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We deliver used appliance rentals across Jackson County and Harrison County:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Ocean Springs</li>
  <li>Biloxi</li>
  <li>Gulfport</li>
  <li>D'Iberville</li>
  <li>Pascagoula</li>
  <li>Gautier</li>
  <li>Long Beach</li>
  <li>Pass Christian</li>
  <li>Moss Point</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Ready to Rent?</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> or <a href="#" class="text-primary hover:underline">get started online</a>. Next-day delivery available across most of the Gulf Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Sudsy Co. Washer and Dryer Rentals</strong> Locally owned. Ocean Springs, MS. Serving the Mississippi Gulf Coast since 2025.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
