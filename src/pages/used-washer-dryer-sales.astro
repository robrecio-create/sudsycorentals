---
import BaseLayout from '../layouts/BaseLayout.astro';
import UsedWasherDryerSalesIsland from '../components/islands/UsedWasherDryerSalesIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Used Washer and Dryer Sales",
  "description": "Buy or rent used washers and dryers in Ocean Springs, MS. All units cleaned, tested, and ready for use.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/used-washer-dryer-sales/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Used Washer and Dryer Sales" }
  ]
};
---

<BaseLayout
  title="Used Washer and Dryer Sales Ocean Springs MS | Sudsy Co."
  description="Buy used washers and dryers in Ocean Springs, MS. Cleaned, tested, and ready to use. Sudsy Co. also offers flexible rental options starting at $59.99/mo."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Used Washer and Dryer Sales in Ocean Springs, MS</h1>
  <UsedWasherDryerSalesIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Why Buy Used From Sudsy Co.?</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">There's a lot of used appliance inventory floating around on Facebook Marketplace and Craigslist on the Gulf Coast. The difference with Sudsy Co.:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li><strong>Every machine is professionally inspected</strong> before it ever goes into a rental or sale</li>
  <li><strong>Serviced and tested</strong> — not a machine we pulled off someone's curb</li>
  <li><strong>We know its history</strong> — machines that come out of our rental program have documented maintenance records</li>
  <li><strong>Local and accountable</strong> — we're not a private seller who disappears after the transaction</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">Buying used from a local appliance rental company is a different category than buying from an unknown private party.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What's Typically Available</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Our used inventory comes from machines rotated out of our rental fleet. These are:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Top-load and front-load washers</li>
  <li>Electric dryers</li>
  <li>Matched washer/dryer sets when available</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">Inventory changes frequently. Call (228) 338-3455 to find out what's currently available and pricing.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Want Installation With Your Purchase?</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">If you buy a used washer or dryer from Sudsy Co., ask about installation service. We offer <a href="/washer-installation" class="text-primary hover:underline">washer installation</a> and <a href="/dryer-installation" class="text-primary hover:underline">dryer installation</a> across our full service area. We can also remove your old appliances at the same time — see <a href="/old-washer-pickup" class="text-primary hover:underline">old washer pickup</a> and <a href="/old-dryer-pickup" class="text-primary hover:underline">old dryer pickup</a>.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Not Ready to Buy? Consider Renting First</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">If you're not sure whether you're staying on the Gulf Coast long-term, renting might make more financial sense than buying. Our <a href="/used-appliance-rental" class="text-primary hover:underline">used appliance rental</a> program starts at $59.99/mo with free delivery and installation — no credit check, no contract. You can always buy later once you know your situation is settled.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Service Area</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Used washer and dryer sales and delivery available across:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Ocean Springs</li>
  <li>Biloxi</li>
  <li>Gulfport</li>
  <li>D'Iberville</li>
  <li>Pascagoula</li>
  <li>Gautier</li>
  <li>Long Beach</li>
  <li>Pass Christian</li>
  <li>Moss Point</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Check Current Inventory</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> to ask about what's available. Inventory moves fast — if you're interested, don't wait.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Sudsy Co. Washer and Dryer Rentals</strong> Locally owned. Ocean Springs, MS. Serving the Mississippi Gulf Coast since 2025.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
