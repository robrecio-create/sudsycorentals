---
import BaseLayout from '../layouts/BaseLayout.astro';
import FurnishedApartmentRentalIsland from '../components/islands/FurnishedApartmentRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Furnished Apartment Rental",
  "description": "Appliance rentals for furnished apartments in Ocean Springs, MS. Free delivery and installation included. No credit check required.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/furnished-apartment-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Furnished Apartment Rental" }
  ]
};
---

<BaseLayout
  title="Furnished Apartment Rental Ocean Springs MS | Sudsy Co."
  description="Furnished apartment rental solutions in Ocean Springs, MS. Rent washers, dryers, and appliances for your apartment. Free delivery, no credit check."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Furnished Apartment Rental in Ocean Springs, MS</h1>
  <FurnishedApartmentRentalIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Furniture Support for Apartment Living</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Furnished apartment rental support works well for:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Temporary apartment stays</li>
  <li>Corporate or work relocations</li>
  <li>Military transitions</li>
  <li>Families between permanent housing</li>
  <li>Property owners furnishing a rental unit</li>
  <li>Residents who want a furnished setup without a big upfront purchase</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Why Furnished Apartment Rental Matters</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">A furnished apartment is more practical, more comfortable, and easier to live in — but buying everything at once can be expensive and time-consuming. Renting furniture gives you a faster path to a usable living space without the long-term commitment of ownership.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Pair It with Appliance Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">If the apartment also needs a washer and dryer, Sudsy Co. can help there too. Our <a href="/home-appliance-rental" class="text-primary hover:underline">home appliance rental</a> and <a href="/washer-and-dryer-rental" class="text-primary hover:underline">washer and dryer rental</a> services make it easier to get the whole space functional without dealing with multiple vendors.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Serving Ocean Springs and the Gulf Coast</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We serve Ocean Springs, Biloxi, Gulfport, D'Iberville, Pascagoula, Gautier, Long Beach, Pass Christian, and Moss Point.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Ask About Furnished Apartment Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> to discuss what kind of apartment setup you need and what inventory is currently available.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
