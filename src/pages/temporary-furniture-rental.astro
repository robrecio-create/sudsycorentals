---
import BaseLayout from '../layouts/BaseLayout.astro';
import TemporaryFurnitureRentalIsland from '../components/islands/TemporaryFurnitureRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Temporary Furniture Rental",
  "description": "Short-term and temporary furniture rental in Ocean Springs, MS for apartments and transitional housing. Month-to-month, no commitment.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/temporary-furniture-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Temporary Furniture Rental" }
  ]
};
---

<BaseLayout
  title="Temporary Furniture Rental Ocean Springs MS | Sudsy Co."
  description="Temporary furniture rental in Ocean Springs, MS. Short-term appliance and furniture rentals for apartments and transitional housing. No credit check."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Temporary Furniture Rental in Ocean Springs, MS</h1>
  <TemporaryFurnitureRentalIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Who Temporary Furniture Rental Is For</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Temporary furniture rental is a strong fit for:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>People relocating to the Gulf Coast</li>
  <li>Families between homes</li>
  <li>Short-term apartment residents</li>
  <li>Military households in transition</li>
  <li>Property owners staging or furnishing a space quickly</li>
  <li>Anyone who needs a furnished setup now without a permanent furniture purchase</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Why Rent Furniture Instead of Buy?</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Buying furniture for a short-term situation usually creates a second problem: what to do with it later. Temporary rental keeps things simple. You get a usable setup fast, avoid the upfront cost of buying, and don't have to worry about selling, storing, or hauling everything when your situation changes.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: A Good Fit for Gulf Coast Moves and Transitions</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">On the Coast, people move for work, military assignments, family changes, and housing transitions all the time. Temporary furniture rental gives those households breathing room. You can get settled now and make longer-term decisions later.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Pair Furniture Rental with Appliance Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">If you're setting up a home from scratch, Sudsy Co. can also help with <a href="/home-appliance-rental" class="text-primary hover:underline">home appliance rental</a>, including washers and dryers. That gives you one local company to help get the space functional fast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Service Area</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We serve Ocean Springs, Biloxi, Gulfport, D'Iberville, Pascagoula, Gautier, Long Beach, Pass Christian, and Moss Point.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Ask About Temporary Furniture Rental</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> to talk through what you need and what inventory is currently available.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
