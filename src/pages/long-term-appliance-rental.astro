---
import BaseLayout from '../layouts/BaseLayout.astro';
import LongTermApplianceRentalIsland from '../components/islands/LongTermApplianceRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Long-Term Appliance Rental",
  "description": "Long-term washer and dryer rental in Ocean Springs, MS with free delivery, installation, and maintenance included.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/long-term-appliance-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Long-Term Appliance Rental" }
  ]
};
---

<BaseLayout
  title="Long-Term Appliance Rental Ocean Springs MS | Sudsy Co."
  description="Long-term appliance rental in Ocean Springs, MS. Rent a washer and dryer starting at $59.99/mo with free delivery and installation. No credit check."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Long-Term Appliance Rental in Ocean Springs, MS</h1>
  <LongTermApplianceRentalIsland client:only="react" />
</BaseLayout>
