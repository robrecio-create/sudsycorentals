---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeApplianceRentalIsland from '../components/islands/HomeApplianceRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Appliance Rental",
  "description": "Home appliance rental service in Ocean Springs including washers and dryers with free delivery and installation.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/home-appliance-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Appliance Rental" }
  ]
};
---

<BaseLayout
  title="Home Appliance Rental Ocean Springs MS | Sudsy Co."
  description="Home appliance rental in Ocean Springs, MS. Rent a washer and dryer starting at $59.99/mo. Free delivery and installation. No credit check required."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Home Appliance Rental in Ocean Springs, MS</h1>
  <HomeApplianceRentalIsland client:only="react" />

  <!-- Rich SEO content — server rendered -->
  <section class="bg-muted/30 py-16">
    <div class="container mx-auto px-4 max-w-4xl">
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: What We Rent</h3>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Washers and Dryers</strong> Our most popular rentals. All rentals are $59.99/mo. We deliver and install everything. We deliver and install everything. If the machine breaks, we fix it — you're not responsible for repairs.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Furniture</strong> We also rent furniture for households that need a complete setup without the full buy-in. Temporary furniture rental, vacation rental setups, and furnished apartment packages available — ask us about current inventory.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: How Home Appliance Rental Works</h3>
<ol class="list-decimal list-inside space-y-2 text-muted-foreground mb-4">
  <li><strong>Pick what you need</strong> — washer/dryer set, furniture, or both</li>
  <li><strong>Schedule delivery</strong> — we offer next-day delivery across the Gulf Coast</li>
  <li><strong>We install it</strong> — hookups, leveling, everything</li>
  <li><strong>Pay monthly</strong> — $59.99/mo for a standard set, month-to-month</li>
  <li><strong>Cancel anytime</strong> — when you're done, we pick it up for free</li>
</ol>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Who Uses Home Appliance Rental in Ocean Springs</h3>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>New Gulf Coast residents.</strong> If you just moved here — for work, for family, for the lifestyle — home appliance rental gets your household running immediately while you figure out your long-term situation.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Military families at Keesler.</strong> Home appliance rental is built for PCS cycles. Bring the essentials you care about, rent the rest, and leave it all behind when orders come without the headache of selling appliances in a Facebook group.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Renters and apartment dwellers.</strong> A lot of Gulf Coast apartments don't include washers and dryers. Home appliance rental fills that gap without the capital investment of buying your own.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Landlords and property managers.</strong> Offer furnished units or in-unit laundry to prospective tenants without tying up capital. Rental appliances are a competitive advantage in the Ocean Springs and Biloxi rental market.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Snowbirds and seasonal residents.</strong> Spend October through April on the Gulf Coast and have a fully equipped home without storing or selling everything in the off-season.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Service Area — Mississippi Gulf Coast</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We deliver home appliance rentals to:
</p>
<ul class="list-disc list-inside space-y-2 text-muted-foreground mb-4">
  <li>Ocean Springs</li>
  <li>Biloxi</li>
  <li>Gulfport</li>
  <li>D'Iberville</li>
  <li>Pascagoula</li>
  <li>Gautier</li>
  <li>Long Beach</li>
  <li>Pass Christian</li>
  <li>Moss Point</li>
</ul>
<p class="text-muted-foreground mb-4 leading-relaxed">Most of our deliveries happen next-day. Call us to confirm your window.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: No Credit Check. No Contract. No Hassle.</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">We don't run your credit. We don't require a lease. Month-to-month billing means you're never locked in — you rent for as long as you need and cancel when your situation changes.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
<h3 class="text-xl font-semibold text-foreground mt-6 mb-3">H2: Get Your Home Set Up Today</h3>
<p class="text-muted-foreground mb-4 leading-relaxed">Call <strong>(228) 338-3455</strong> or <a href="#" class="text-primary hover:underline">start your rental online</a>. We'll confirm your delivery window and get your home running as soon as tomorrow.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed"><strong>Sudsy Co. Washer and Dryer Rentals</strong> Locally owned. Ocean Springs, MS. Mississippi Gulf Coast.
</p>
<p class="text-muted-foreground mb-4 leading-relaxed">---
</p>
    </div>
  </section>
</BaseLayout>
