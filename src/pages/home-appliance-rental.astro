---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeApplianceRentalIsland from '../components/islands/HomeApplianceRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Home Appliance Rental",
  "description": "Home appliance rental service in Ocean Springs including washers and dryers with free delivery and installation.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/home-appliance-rental/",
  "offers": {
    "@type": "Offer",
    "price": "59.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "59.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Home Appliance Rental" }
  ]
};
---

<BaseLayout
  title="Home Appliance Rental Ocean Springs MS | Sudsy Co."
  description="Home appliance rental in Ocean Springs, MS. Rent a washer and dryer starting at $59.99/mo. Free delivery and installation. No credit check required."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Home Appliance Rental in Ocean Springs, MS</h1>
  <HomeApplianceRentalIsland client:only="react" />
</BaseLayout>
