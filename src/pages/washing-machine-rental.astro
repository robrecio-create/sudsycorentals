---
import BaseLayout from '../layouts/BaseLayout.astro';
import WashingMachineRentalIsland from '../components/islands/WashingMachineRentalIsland';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Washing Machine Rental",
  "description": "Rent a washing machine in Ocean Springs, MS with free delivery and installation. No credit check required.",
  "provider": {
    "@type": "LocalBusiness",
    "@id": "https://www.sudsycorentals.com/#localbusiness",
    "name": "Sudsy Co. Rentals",
    "telephone": "+1-228-338-3455",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1302 Fort St",
      "addressLocality": "Ocean Springs",
      "addressRegion": "MS",
      "postalCode": "39564",
      "addressCountry": "US"
    }
  },
  "areaServed": {
    "@type": "State",
    "name": "Mississippi"
  },
  "url": "https://www.sudsycorentals.com/washing-machine-rental/",
  "offers": {
    "@type": "Offer",
    "price": "39.99",
    "priceCurrency": "USD",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "39.99",
      "priceCurrency": "USD",
      "unitText": "month"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sudsycorentals.com" },
    { "@type": "ListItem", "position": 2, "name": "Washing Machine Rental" }
  ]
};
---

<BaseLayout
  title="Washing Machine Rental Ocean Springs MS | Sudsy Co."
  description="Rent a washing machine in Ocean Springs, MS starting at $39.99/mo. Free next-day delivery, free installation, no credit check. Serving the Mississippi Gulf Coast."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <h1 class="sr-only">Washing Machine Rental in Ocean Springs, MS</h1>
  <WashingMachineRentalIsland client:only="react" />
</BaseLayout>
